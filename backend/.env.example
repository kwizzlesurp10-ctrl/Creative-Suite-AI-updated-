# AnyTool Backend Environment Configuration

# Required: Gemini API Key for AI operations
GEMINI_API_KEY=your_key_here

# Server Configuration
PORT=5001
HOST=0.0.0.0
DEBUG=False

# AnyTool Settings
ANYTOOL_LOG_LEVEL=INFO
ANYTOOL_WORKSPACE=/tmp/anytool_workspace

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Task Management
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=3600

# Workspace Cleanup
WORKSPACE_RETENTION_HOURS=24
